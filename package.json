{
  "name": "yes-programme-hub",
  "version": "1.0.0",
  "description": "YES Programme Lifecycle Hub",
  "repository": "https://github.com/lusandadotnet/yes-programme-hub.git",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^3",
    "@cap-js/sqlite": "^3.1.1",
    "@sap/cds": "^10.1.1",
    "@sap/xssec": "4.15.0",
    "express": "^4.18.2",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@sap/cds-dk": "^10.1.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "SuccessFactorsAPI": {
        "kind": "odata-v4",
        "credentials": {
          "destination": "SuccessFactors-Destination"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      }
    }
  },
  "sapux": []
}
