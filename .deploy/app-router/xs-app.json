{
  "welcomeFile": "/index.html",
  "routes": [
    {
      "source": "^/odata/v4/(.*)$",
      "target": "/odata/v4/$1",
      "destination": "srv-api",
      "csrfProtection": true,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^(.*)$",
      "localDir": "webapp",
      "authenticationType": "xsuaa"
    }
  ]
}
